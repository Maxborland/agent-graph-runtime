{
  "version": 1,
  "run": {
    "id": "installed-claudex-smoke-v13",
    "objective": "Prove that the configured Claudex launcher executes directly and returns machine-verifiable model usage without modifying files",
    "repository": "..",
    "maxConcurrency": 1,
    "allowExternalActions": false,
    "codeGraph": false
  },
  "nodes": [
    {
      "id": "claudex-review",
      "type": "review",
      "executor": "claudex",
      "prompt": "Inspect package.json directly without launching Workflow, Task, or any subagent. Return a complete structured handoff and do not edit any file.",
      "needs": [],
      "owns": [],
      "checks": [],
      "maxAttempts": 1,
      "timeoutMs": 300000,
      "requiredModelUsage": [
        {
          "model": "gpt-5.6-sol",
          "provider": "firstParty",
          "contextWindow": 262144
        }
      ]
    },
    {
      "id": "package-checks",
      "type": "verify",
      "needs": ["claudex-review"],
      "owns": [],
      "checks": ["pnpm test"],
      "maxAttempts": 1,
      "timeoutMs": 120000
    }
  ]
}
