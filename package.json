{
  "name": "@quidni/agent-graph-runtime",
  "version": "0.6.0",
  "description": "Local graph runtime for autonomous Codex, Claude Code, and Claudex workflows",
  "type": "module",
  "bin": {
    "agr": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "skills",
    "examples",
    "docs/SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/**/*.test.js",
    "check": "pnpm run test",
    "start": "node dist/src/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@10.33.2",
  "license": "MIT"
}
